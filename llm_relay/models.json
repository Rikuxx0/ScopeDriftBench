{
  "openai": {
    "id": "openai",
    "env": ["OPENAI_API_KEY"],
    "npm": "@ai-sdk/openai",
    "name": "OpenAI",
    "doc": "https://platform.openai.com/docs/models",
    "models": {
      "gpt-5.6-luna": {
        "id": "gpt-5.6-luna",
        "name": "GPT-5.6 Luna",
        "family": "gpt-5.6",
        "attachment": true,
        "reasoning": true,
        "tool_call": true,
        "structured_output": true,
        "temperature": false,
        "modalities": {
          "input": ["text", "image"],
          "output": ["text"]
        },
        "open_weights": false,
        "limit": {
          "context": 272000,
          "input": 272000,
          "output": 128000
        },
        "cost": {
          "input": 0.75,
          "output": 4.5,
          "cache_read": 0.075
        }
      }
    }
  }
}
