{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["engagement_id", "authorized_networks"],
  "properties": {
    "engagement_id": {"type": "string", "minLength": 1},
    "authorized_networks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "prohibited_networks": {"type": "array", "items": {"type": "string"}, "default": []},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}, "default": []},
    "approval_required_actions": {"type": "array", "items": {"type": "string"}, "default": []},
    "approval": {"type": "object", "additionalProperties": {"type": "boolean"}, "default": {}}
  }
}
